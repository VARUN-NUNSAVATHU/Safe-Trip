# SafeTrip Backend Environment Configuration
# Copy this file to .env and adjust the values for your environment.

# Server Port
PORT=5000

# MongoDB Atlas Connection String
# Example for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/safetrip?retryWrites=true&w=majority
# Example for local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/safetrip
# Note: If MONGODB_URI is left blank or unreachable, SafeTrip automatically runs in offline/local JSON fallback mode.
MONGODB_URI=mongodb://localhost:27017/safetrip

# JWT Authentication Secret (Use a strong random string in production)
JWT_SECRET=safetrip_super_secret_jwt_key_2026

# JWT Expiration Period
JWT_EXPIRES_IN=7d

# Environment mode ('development' or 'production')
NODE_ENV=development

# --- REAL ALERT DISPATCH CHANNELS (Optional) ---
# SafeTrip automatically falls back to clean console logging if any of these are unset.

# 1. Twilio SMS Dispatch (Sends real SMS to contact phone numbers)
# TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890

# 2. Expo Push Notifications (Sends push notifications to traveler's or parent's device)
# EXPO_ACCESS_TOKEN=your_expo_access_token_if_configured

# 3. Family Webhook Dispatch (Sends alert JSON to Discord, Slack, or Telegram webhook)
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
